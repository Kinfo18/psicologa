---
const currentYear = new Date().getFullYear();

const navLinks = [
  { href: '#sobre-mi',    label: 'Sobre mí' },
  { href: '#servicios',   label: 'Servicios' },
  { href: '#proceso',     label: 'Proceso terapéutico' },
  { href: '#modalidades', label: 'Modalidades' },
  { href: '#contacto',    label: 'Contacto' },
];
---

<footer class="footer" role="contentinfo">
  <div class="footer-top">
    <div class="container footer-grid">

      <!-- Brand column -->
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="Sofía Marcela Pedraza — Inicio">
          <img
            src="/assets/images/logo-fondo-blanco.png"
            alt="Logo Sofía Marcela Pedraza Lozano"
            width="160"
            height="64"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="footer-desc">
          Psicóloga clínica y comunitaria en Yopal, Casanare. Atención empática,
          contextualizada y basada en evidencia para tu bienestar emocional.
        </p>
        <div class="footer-socials" role="list" aria-label="Redes sociales">
          <a
            href="https://instagram.com/sofiapedrazapsicologa"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social"
            aria-label="Instagram"
            role="listitem"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a
            href="https://facebook.com/sofiapedrazapsicologa"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social"
            aria-label="Facebook"
            role="listitem"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a
            href="https://x.com/sofiapsicologa"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social"
            aria-label="X (Twitter)"
            role="listitem"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.261 5.632zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Navigation -->
      <nav class="footer-nav" aria-label="Navegación del pie de página">
        <p class="footer-nav-title">Navegación</p>
        <ul role="list">
          {navLinks.map(link => (
            <li>
              <a href={link.href} class="footer-link">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Contact info -->
      <div class="footer-contact">
        <p class="footer-nav-title">Contacto</p>
        <ul role="list" class="contact-list">
          <li class="contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            <span>Yopal, Casanare, Colombia</span>
          </li>
          <li class="contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            <a
              href="https://wa.me/573000000000"
              target="_blank"
              rel="noopener noreferrer"
              class="footer-link"
            >WhatsApp: +57 300 000 0000</a>
          </li>
          <li class="contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            <span>Lunes a sábado · Horario flexible</span>
          </li>
          <li class="contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>Colpsic · Registro profesional activo</span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>&copy; {currentYear} Sofía Marcela Pedraza Lozano. Todos los derechos reservados.</p>
      <p class="footer-tagline">Psicóloga Clínica y Comunitaria · Yopal, Casanare · Colombia</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-text);
  }

  .footer-top {
    padding: var(--space-16) 0 var(--space-12);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
  }

  @media (min-width: 768px) {
    .footer-grid { grid-template-columns: 1.5fr 1fr 1fr; gap: var(--space-12); }
  }

  /* Brand */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .footer-logo img {
    height: 56px;
    width: auto;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  .footer-desc {
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.5);
    line-height: 1.75;
    max-width: 36ch;
  }

  .footer-socials {
    display: flex;
    gap: var(--space-3);
  }

  .footer-social {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.55);
    transition: all var(--dur-base) var(--ease-out);
  }

  .footer-social:hover {
    background: var(--color1);
    border-color: var(--color1);
    color: #fff;
    transform: translateY(-2px);
  }

  .footer-social:focus-visible {
    outline: 3px solid var(--color4);
    outline-offset: 2px;
  }

  /* Nav */
  .footer-nav-title {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
    margin-bottom: var(--space-4);
    max-width: none;
  }

  .footer-nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-link {
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.55);
    font-weight: 500;
    transition: color var(--dur-fast);
  }

  .footer-link:hover {
    color: var(--color5);
  }

  .footer-link:focus-visible {
    outline: 2px solid var(--color4);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* Contact list */
  .contact-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.5);
    line-height: 1.5;
  }

  .contact-item svg {
    color: var(--color4);
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Bottom bar */
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.07);
    padding: var(--space-5) 0;
  }

  .footer-bottom-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: center;
    text-align: center;
  }

  @media (min-width: 768px) {
    .footer-bottom-inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .footer-bottom p {
    font-size: var(--text-xs);
    color: rgba(255,255,255,0.3);
    max-width: none;
    margin: 0;
    line-height: 1;
  }

  .footer-tagline {
    color: rgba(255,255,255,0.2) !important;
  }
</style>
