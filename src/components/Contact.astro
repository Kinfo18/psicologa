---
---
<section id="contacto" class="section contact" aria-labelledby="contact-heading">

  <!-- Decorative top wave -->
  <div class="contact-top-deco" aria-hidden="true"></div>

  <div class="container contact-inner">

    <!-- Left: copy -->
    <div class="contact-text reveal-left">
      <p class="section-label">Agenda tu consulta</p>

      <h2 id="contact-heading" class="section-heading">
        El primer paso<br>
        <em>ya está dado.</em>
      </h2>

      <p class="contact-sub">
        Buscar ayuda es un acto de valentía, no de debilidad. Escríbeme y en
        menos de 24 horas coordinamos tu primera sesión, sin compromisos y sin
        formularios interminables.
      </p>

      <!-- Steps to contact -->
      <ol class="contact-steps" role="list">
        <li class="contact-step">
          <span class="step-badge" aria-hidden="true">1</span>
          <span>Escríbeme por WhatsApp o Instagram</span>
        </li>
        <li class="contact-step">
          <span class="step-badge" aria-hidden="true">2</span>
          <span>Cuéntame brevemente qué te trae</span>
        </li>
        <li class="contact-step">
          <span class="step-badge" aria-hidden="true">3</span>
          <span>Coordinamos el horario y la modalidad</span>
        </li>
      </ol>

      <!-- Trust signals -->
      <div class="contact-trust">
        <div class="trust-chip">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          Confidencialidad garantizada
        </div>
        <div class="trust-chip">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Registro Colpsic activo
        </div>
        <div class="trust-chip">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          Respuesta en menos de 24 h
        </div>
      </div>
    </div>

    <!-- Right: CTA card -->
    <div class="contact-card reveal-right delay-200">

      <div class="contact-card-header">
        <img
          src="/assets/images/psicologa-sin-fondo-1.png"
          alt="Sofía Marcela Pedraza Lozano, psicóloga disponible para atenderte"
          class="contact-photo"
          width="200"
          height="260"
          loading="lazy"
          decoding="async"
        />
        <div class="contact-card-title">
          <h3>¿Lista/o para empezar?</h3>
          <p>Estoy disponible para acompañarte en este proceso.</p>
        </div>
      </div>

      <a
        href="https://wa.me/573000000000?text=Hola%20Sof%C3%ADa%2C%20me%20gustar%C3%ADa%20agendar%20una%20primera%20consulta.%20"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-whatsapp btn-lg contact-wa-btn"
        aria-label="Contactar a Sofía por WhatsApp para agendar consulta"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        Escribirme por WhatsApp
      </a>

      <div class="contact-divider" aria-hidden="true">
        <span>o también puedes encontrarme en</span>
      </div>

      <!-- Social links -->
      <div class="contact-socials" role="list" aria-label="Redes sociales">
        <a
          href="https://instagram.com/sofiapedrazapsicologa"
          target="_blank"
          rel="noopener noreferrer"
          class="social-link"
          aria-label="Instagram de Sofía Marcela Pedraza Lozano"
          role="listitem"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span>Instagram</span>
        </a>

        <a
          href="https://facebook.com/sofiapedrazapsicologa"
          target="_blank"
          rel="noopener noreferrer"
          class="social-link"
          aria-label="Facebook de Sofía Marcela Pedraza Lozano"
          role="listitem"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          <span>Facebook</span>
        </a>

        <a
          href="https://x.com/sofiapsicologa"
          target="_blank"
          rel="noopener noreferrer"
          class="social-link"
          aria-label="X (Twitter) de Sofía Marcela Pedraza Lozano"
          role="listitem"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.261 5.632zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
          <span>X (Twitter)</span>
        </a>
      </div>

      <!-- Location -->
      <div class="contact-location">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
        </svg>
        <span>Consultorio en Yopal, Casanare · Atención virtual para Colombia</span>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--color-surface-2);
    position: relative;
    overflow: hidden;
  }

  .contact-top-deco {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--grad-secondary);
  }

  .contact-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  @media (min-width: 960px) {
    .contact-inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-16);
      align-items: center;
    }
  }

  /* Text side */
  .contact-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .contact-sub {
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--color-text-muted);
    max-width: 52ch;
  }

  /* Steps */
  .contact-steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact-step {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .step-badge {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--grad-card);
    border: 2px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color2);
    flex-shrink: 0;
  }

  /* Trust chips */
  .contact-trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .trust-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 6px 14px;
  }

  .trust-chip svg { color: var(--color3); }

  /* Card */
  .contact-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .contact-card-header {
    display: flex;
    align-items: flex-end;
    gap: var(--space-4);
  }

  .contact-photo {
    height: 100px;
    width: auto;
    object-fit: contain;
    object-position: bottom;
    filter: drop-shadow(0 4px 12px rgba(59,29,225,0.2));
    flex-shrink: 0;
  }

  .contact-card-title h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.3;
    margin-bottom: var(--space-1);
  }

  .contact-card-title p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    max-width: none;
    line-height: 1.4;
  }

  .contact-wa-btn {
    width: 100%;
    justify-content: center;
    font-size: var(--text-base);
  }

  /* Divider */
  .contact-divider {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    color: var(--color-text-faint);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .contact-divider::before,
  .contact-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-divider);
  }

  /* Social links */
  .contact-socials {
    display: flex;
    gap: var(--space-3);
  }

  .social-link {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    transition: all var(--dur-base) var(--ease-out);
    min-height: 44px;
  }

  .social-link:hover {
    background: var(--color-surface-offset);
    border-color: var(--color4);
    color: var(--color2);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  @media (max-width: 400px) {
    .social-link span { display: none; }
  }

  /* Location */
  .contact-location {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-faint);
    font-weight: 500;
  }

  .contact-location svg { color: var(--color4); flex-shrink: 0; }
</style>
