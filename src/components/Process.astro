---
const steps = [
  {
    num: '1',
    title: 'Primera consulta',
    desc: 'Un encuentro exploratorio donde me cuentas lo que te trae. Sin formularios complicados, sin presiones. Solo escucha real.',
    detail: 'Sin compromiso · 50 minutos',
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
  },
  {
    num: '2',
    title: 'Evaluación y plan',
    desc: 'Juntos identificamos qué está ocurriendo y construimos un plan terapéutico personalizado, claro y alcanzable.',
    detail: 'Adaptado a tu ritmo',
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`,
  },
  {
    num: '3',
    title: 'Proceso terapéutico',
    desc: 'Sesiones semanales o quincenales con técnicas de TCC, enfoque humanista y herramientas prácticas para tu vida cotidiana.',
    detail: 'Presencial o virtual',
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96-.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3z"/></svg>`,
  },
  {
    num: '4',
    title: 'Cierre y seguimiento',
    desc: 'Cuando alcancemos los objetivos, cerramos con una revisión de tus logros y acordamos cómo mantenerte en el camino.',
    detail: 'A tu propio tiempo',
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`,
  },
];
---

<section id="proceso" class="section process" aria-labelledby="process-heading">
  <div class="container">

    <div class="process-header">
      <p class="section-label reveal">Proceso terapéutico</p>
      <h2 id="process-heading" class="section-heading reveal delay-100">
        ¿Cómo funciona<br>
        <em>la terapia?</em>
      </h2>
      <p class="section-sub reveal delay-200">
        La terapia no tiene un guión fijo, pero sí una estructura que te ayudará
        a saber dónde estás y hacia dónde vas.
      </p>
    </div>

    <ol class="process-steps" role="list">
      {steps.map((step, i) => (
        <li class={`process-step reveal delay-${(i + 1) * 100}`}>
          <!-- Connector line (hidden on last) -->
          {i < steps.length - 1 && (
            <div class="step-connector" aria-hidden="true"></div>
          )}

          <div class="step-number-col">
            <div class="step-circle">
              <span class="step-num" aria-hidden="true">{step.num}</span>
            </div>
          </div>

          <div class="step-content">
            <div class="step-icon" aria-hidden="true" set:html={step.icon} />
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.desc}</p>
            <span class="step-detail">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
              {step.detail}
            </span>
          </div>
        </li>
      ))}
    </ol>

    <div class="process-note reveal">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
      <p>Cada proceso es único. La duración, la frecuencia y las herramientas se adaptan a ti, no al revés.</p>
    </div>
  </div>
</section>

<style>
  .process {
    background: var(--color-surface);
    position: relative;
    overflow: hidden;
  }

  .process::before {
    content: '';
    position: absolute;
    bottom: -100px;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 400px;
    background: radial-gradient(ellipse, rgba(172, 119, 247, 0.06) 0%, transparent 70%);
    pointer-events: none;
  }

  .process-header {
    max-width: 580px;
    margin-bottom: var(--space-16);
  }

  /* Steps */
  .process-steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    position: relative;
    margin-bottom: var(--space-10);
  }

  @media (min-width: 768px) {
    .process-steps {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8);
    }
  }

  @media (min-width: 1100px) {
    .process-steps {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-6);
    }
  }

  .process-step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  /* Connector line (desktop only) */
  .step-connector {
    display: none;
  }

  @media (min-width: 1100px) {
    .step-connector {
      display: block;
      position: absolute;
      top: 22px;
      left: calc(100% + 12px);
      width: calc(100% - 24px);
      height: 2px;
      background: linear-gradient(to right, var(--color3), var(--color5));
      opacity: 0.3;
      z-index: 0;
    }
  }

  /* Step number */
  .step-number-col {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .step-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--grad-hero);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    box-shadow: 0 4px 16px rgba(59, 29, 225, 0.35);
  }

  .step-num {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    color: #fff;
  }

  /* Step content */
  .step-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    transition: transform var(--dur-base) var(--ease-out),
                box-shadow var(--dur-base) var(--ease-out),
                border-color var(--dur-base);
  }

  .step-content:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--color4);
  }

  .step-icon {
    color: var(--color3);
    width: 26px;
    height: 26px;
  }

  .step-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.3;
  }

  .step-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: none;
    flex: 1;
  }

  .step-detail {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color3);
    letter-spacing: 0.04em;
    margin-top: auto;
  }

  /* Note */
  .process-note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
    color: var(--color3);
  }

  .process-note svg { flex-shrink: 0; margin-top: 2px; }

  .process-note p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: none;
    margin: 0;
    font-style: italic;
  }
</style>
