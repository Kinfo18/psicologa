---
---
<section id="modalidades" class="section modalities" aria-labelledby="modalities-heading">
  <div class="container">

    <div class="mod-header">
      <p class="section-label reveal">Modalidades de atención</p>
      <h2 id="modalities-heading" class="section-heading reveal delay-100">
        Donde estés,<br>
        <em>te acompaño</em>
      </h2>
      <p class="section-sub reveal delay-200">
        Lunes a sábado con agenda flexible, porque tu bienestar
        no debería depender de la distancia.
      </p>
    </div>

    <div class="mod-grid">

      <!-- Card: Presencial -->
      <div class="mod-card mod-card--presencial reveal-left">
        <div class="mod-card-inner">
          <div class="mod-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <div class="mod-badge">
            <span class="badge-dot presencial-dot" aria-hidden="true"></span>
            Presencial
          </div>
          <h3 class="mod-title">Consultorio en Yopal</h3>
          <p class="mod-desc">
            Sesiones cara a cara en un espacio diseñado para la comodidad,
            la confidencialidad y la concentración. Sin distracciones, con toda
            la presencia.
          </p>
          <ul class="mod-features" role="list">
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
              Consultorio en Yopal, Casanare
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
              Lunes a sábado · Horario flexible
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
              Espacio privado y seguro
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
              Accesible desde municipios del departamento
            </li>
          </ul>
          <a
            href="https://wa.me/573000000000?text=Hola%20Sof%C3%ADa%2C%20quiero%20agendar%20una%20consulta%20presencial"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
            aria-label="Agendar consulta presencial por WhatsApp"
          >
            Agendar presencial
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
        <!-- Decorative photo -->
        <div class="mod-photo-wrap" aria-hidden="true">
          <img
            src="/assets/images/psicologa-3.png"
            alt=""
            class="mod-photo"
            width="400"
            height="500"
            loading="lazy"
            decoding="async"
          />
          <div class="mod-photo-overlay"></div>
        </div>
      </div>

      <!-- Card: Virtual -->
      <div class="mod-card mod-card--virtual reveal-right delay-200">
        <div class="mod-card-inner">
          <div class="mod-icon mod-icon--virtual" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/>
              <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
          <div class="mod-badge mod-badge--virtual">
            <span class="badge-dot virtual-dot" aria-hidden="true"></span>
            Virtual
          </div>
          <h3 class="mod-title">Videollamada para todo el país</h3>
          <p class="mod-desc">
            La distancia no es una razón para no buscar ayuda. Sesiones
            por videollamada con la misma calidad, confidencialidad y presencia
            que en el consultorio.
          </p>
          <ul class="mod-features" role="list">
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
              Disponible para toda Colombia
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
              Ideal para municipios remotos del Casanare
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
              Plataforma segura y confidencial
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
              Flexibilidad de horario
            </li>
          </ul>
          <a
            href="https://wa.me/573000000000?text=Hola%20Sof%C3%ADa%2C%20quiero%20agendar%20una%20consulta%20virtual"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost"
            aria-label="Agendar consulta virtual por WhatsApp"
          >
            Agendar virtual
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

        <!-- Map-like decorative -->
        <div class="mod-map" aria-hidden="true">
          <div class="map-dot map-dot-1">
            <span>Yopal</span>
          </div>
          <div class="map-dot map-dot-2">
            <span>San Luis de Palenque</span>
          </div>
          <div class="map-dot map-dot-3">
            <span>Trinidad</span>
          </div>
          <div class="map-dot map-dot-4">
            <span>Hato Corozal</span>
          </div>
          <svg class="map-lines" viewBox="0 0 300 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="150" cy="100" r="60" stroke="rgba(172,119,247,0.2)" stroke-width="1" stroke-dasharray="4 4"/>
            <circle cx="150" cy="100" r="110" stroke="rgba(172,119,247,0.12)" stroke-width="1" stroke-dasharray="4 4"/>
            <line x1="150" y1="100" x2="80" y2="60" stroke="rgba(172,119,247,0.3)" stroke-width="1"/>
            <line x1="150" y1="100" x2="220" y2="70" stroke="rgba(172,119,247,0.3)" stroke-width="1"/>
            <line x1="150" y1="100" x2="60" y2="140" stroke="rgba(172,119,247,0.3)" stroke-width="1"/>
            <line x1="150" y1="100" x2="240" y2="150" stroke="rgba(172,119,247,0.3)" stroke-width="1"/>
            <circle cx="150" cy="100" r="6" fill="url(#pulse-grad)"/>
            <defs>
              <radialGradient id="pulse-grad">
                <stop offset="0%" stop-color="#3b1de1"/>
                <stop offset="100%" stop-color="#8659f0"/>
              </radialGradient>
            </defs>
          </svg>
        </div>
      </div>
    </div>

    <!-- Schedule indicator -->
    <div class="mod-schedule reveal">
      <div class="schedule-icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
      </div>
      <div>
        <p class="schedule-title">Lunes a sábado · Agenda flexible</p>
        <p class="schedule-sub">Escríbeme por WhatsApp y coordinamos el horario que mejor se adapte a ti.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .modalities {
    background: var(--color-bg);
    position: relative;
    overflow: hidden;
  }

  .mod-header {
    max-width: 580px;
    margin-bottom: var(--space-12);
  }

  /* Grid */
  .mod-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 900px) {
    .mod-grid { grid-template-columns: 1fr 1fr; }
  }

  /* Card base */
  .mod-card {
    border-radius: var(--radius-xl);
    overflow: hidden;
    position: relative;
    min-height: 480px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border: 1px solid var(--color-border);
    transition: box-shadow var(--dur-base) var(--ease-out),
                transform var(--dur-base) var(--ease-out);
  }

  .mod-card:hover {
    box-shadow: var(--shadow-xl);
    transform: translateY(-4px);
  }

  /* Presencial card: photo background */
  .mod-card--presencial {
    background: var(--color-surface);
  }

  .mod-photo-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .mod-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .mod-photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(21, 16, 61, 0.97) 0%,
      rgba(21, 16, 61, 0.75) 45%,
      rgba(21, 16, 61, 0.2) 100%
    );
  }

  .mod-card-inner {
    position: relative;
    z-index: 1;
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
  }

  /* Virtual card: gradient background */
  .mod-card--virtual {
    background: var(--color-surface-2);
  }

  .mod-map {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 0;
    opacity: 0.6;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .map-lines {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .map-dot {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 700;
    color: var(--color3);
    letter-spacing: 0.06em;
  }

  .map-dot::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color3);
    flex-shrink: 0;
    animation: pulse-map 2s ease-in-out infinite;
  }

  .map-dot-1 { top: 45%; left: 45%; }
  .map-dot-2 { top: 25%; left: 20%; }
  .map-dot-3 { top: 30%; right: 15%; }
  .map-dot-4 { bottom: 30%; left: 15%; }

  @keyframes pulse-map {
    0%, 100% { box-shadow: 0 0 0 0 rgba(134,89,240,0.4); }
    50%       { box-shadow: 0 0 0 6px rgba(134,89,240,0); }
  }

  /* Icon */
  .mod-icon {
    width: 60px;
    height: 60px;
    border-radius: var(--radius-lg);
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
  }

  .mod-card--virtual .mod-icon {
    background: var(--color-surface-offset);
    border-color: var(--color-border);
    color: var(--color2);
  }

  /* Badge */
  .mod-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
    padding: 0;
  }

  .mod-card--virtual .mod-badge { color: var(--color-text-muted); }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    animation: pulse-dot 2s ease-in-out infinite;
  }

  .presencial-dot { background: #d295ff; }
  .virtual-dot    { background: var(--color3); }

  /* Title */
  .mod-title {
    font-family: var(--font-display);
    font-size: clamp(var(--text-xl), 2.5vw, var(--text-3xl));
    font-weight: 700;
    color: #fff;
    line-height: 1.2;
  }

  .mod-card--virtual .mod-title { color: var(--color-text); }

  /* Description */
  .mod-desc {
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.72);
    line-height: 1.7;
    max-width: 44ch;
  }

  .mod-card--virtual .mod-desc { color: var(--color-text-muted); }

  /* Feature list */
  .mod-features {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    list-style: none;
  }

  .mod-features li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.8);
    font-weight: 500;
  }

  .mod-card--virtual .mod-features li { color: var(--color-text-muted); }

  .mod-features svg {
    color: var(--color5);
    flex-shrink: 0;
  }

  .mod-card--virtual .mod-features svg { color: var(--color3); }

  /* Schedule bar */
  .mod-schedule {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .schedule-icon {
    width: 48px;
    height: 48px;
    background: var(--grad-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color2);
    flex-shrink: 0;
  }

  .schedule-title {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
    max-width: none;
  }

  .schedule-sub {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    max-width: none;
    line-height: 1.5;
  }

  @keyframes pulse-dot {
    0%, 100% { transform: scale(1); opacity: 1; }
    50%       { transform: scale(1.3); opacity: 0.7; }
  }

  @media (prefers-reduced-motion: reduce) {
    .badge-dot, .map-dot::before { animation: none; }
  }
</style>
