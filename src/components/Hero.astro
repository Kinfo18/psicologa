---
---
<section id="inicio" class="hero" aria-label="Sección principal">

  <!-- Background image + overlay -->
  <div class="hero-bg" aria-hidden="true">
    <img
      src="/assets/images/hero-bg.png"
      alt=""
      class="hero-bg-img"
      width="1920"
      height="1080"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-overlay"></div>
  </div>

  <!-- Decorative shapes -->
  <div class="hero-shapes" aria-hidden="true">
    <div class="shape shape-circle-lg"></div>
    <div class="shape shape-circle-sm"></div>
    <div class="shape shape-ring"></div>
    <div class="shape shape-dot-grid"></div>
  </div>

  <!-- Content grid -->
  <div class="hero-grid container">

    <!-- Left — text content -->
    <div class="hero-content">

      <div class="hero-badge reveal">
        <span class="badge-dot" aria-hidden="true"></span>
        Psicóloga Clínica &amp; Comunitaria · Yopal, Casanare
      </div>

      <h1 class="hero-title reveal delay-100">
        Escuchar de verdad,<br>
        <em>para sanar</em><br>
        de verdad.
      </h1>

      <p class="hero-sub reveal delay-200">
        Acompañamiento psicológico con rigor académico y calidez humana.
        Presencial en Yopal, virtual para todo el Casanare y Colombia.
      </p>

      <div class="hero-actions reveal delay-300">
        <a
          href="https://wa.me/573000000000?text=Hola%20Sof%C3%ADa%2C%20quiero%20agendar%20mi%20primera%20consulta"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary btn-lg"
          aria-label="Agendar primera consulta por WhatsApp"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          Agenda tu primera consulta
        </a>

        <a href="#sobre-mi" class="btn btn-hero-ghost">
          <span>Conoce mi enfoque</span>
          <span class="btn-hero-ghost-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </span>
        </a>
      </div>

      <!-- Trust indicators -->
      <div class="hero-trust reveal delay-400">
        <div class="trust-item">
          <strong>Colpsic</strong>
          <span>Registro activo</span>
        </div>
        <div class="trust-divider" aria-hidden="true"></div>
        <div class="trust-item">
          <strong>Distinción</strong>
          <span>Egresada con honor</span>
        </div>
        <div class="trust-divider" aria-hidden="true"></div>
        <div class="trust-item">
          <strong>Presencial &amp; Virtual</strong>
          <span>Casanare y Colombia</span>
        </div>
      </div>
    </div>

    <!-- Right — psychologist photo -->
    <div class="hero-photo reveal-right delay-200" aria-hidden="true">
      <img
        src="/assets/images/psicologa-sin-fondo-1.png"
        alt="Sofía Marcela Pedraza Lozano, Psicóloga en Yopal Casanare"
        class="hero-img"
        width="600"
        height="800"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <!-- Floating accent card -->
      <div class="hero-card-float">
        <div class="float-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </div>
        <div>
          <p class="float-title">Un espacio seguro</p>
          <p class="float-sub">Sin juicios, con escucha real.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="hero-scroll" aria-hidden="true">
    <span class="scroll-line"></span>
    <span class="scroll-label">Descubre más</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    padding-top: var(--nav-height);
  }

  /* Background */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(15, 10, 46, 0.88) 0%,
      rgba(59, 29, 225, 0.72) 55%,
      rgba(134, 89, 240, 0.45) 100%
    );
  }

  /* Decorative shapes */
  .hero-shapes { position: absolute; inset: 0; z-index: 1; overflow: hidden; }

  .shape-circle-lg {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(172, 119, 247, 0.15) 0%, transparent 70%);
    top: -200px;
    right: -100px;
    animation: drift 12s ease-in-out infinite;
  }

  .shape-circle-sm {
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(210, 149, 255, 0.12) 0%, transparent 70%);
    bottom: 10%;
    left: 5%;
    animation: drift 10s ease-in-out infinite reverse;
  }

  .shape-ring {
    width: 200px;
    height: 200px;
    border: 2px solid rgba(172, 119, 247, 0.2);
    border-radius: 50%;
    top: 30%;
    right: 25%;
    animation: rotate-slow 30s linear infinite;
  }

  .shape-dot-grid {
    width: 180px;
    height: 180px;
    background-image: radial-gradient(circle, rgba(210, 149, 255, 0.3) 1px, transparent 1px);
    background-size: 20px 20px;
    bottom: 20%;
    right: 10%;
    opacity: 0.4;
  }

  @keyframes drift {
    0%, 100% { transform: translate(0, 0); }
    50%       { transform: translate(20px, -30px); }
  }

  @keyframes rotate-slow {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  /* Grid */
  .hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: end;
    padding-top: var(--space-12);
    padding-bottom: var(--space-20);
    min-height: calc(100svh - var(--nav-height));
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--space-12);
    }
  }

  @media (min-width: 1200px) {
    .hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  /* Text content */
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.22);
    color: rgba(255,255,255,0.9);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    width: fit-content;
    backdrop-filter: blur(8px);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color5);
    animation: pulse-dot 2s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes pulse-dot {
    0%, 100% { transform: scale(1); opacity: 1; }
    50%       { transform: scale(1.3); opacity: 0.7; }
  }

  /* Title */
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5.5vw, 5.5rem);
    font-weight: 700;
    line-height: 1.1;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .hero-title em {
    font-style: italic;
    background: linear-gradient(135deg, var(--color5) 0%, var(--color4) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Subtitle */
  .hero-sub {
    font-size: clamp(var(--text-base), 1.5vw, var(--text-xl));
    color: rgba(255,255,255,0.78);
    line-height: 1.7;
    max-width: 52ch;
    font-weight: 400;
  }

  /* Actions */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
  }

  .btn-hero-ghost {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.9);
    padding: 14px 28px;
    border: 1.5px solid rgba(255, 255, 255, 0.28);
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(8px);
    min-height: 52px;
    position: relative;
    overflow: hidden;
    transition:
      color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      background var(--dur-base) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .btn-hero-ghost::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--color3), var(--color1));
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
    border-radius: inherit;
  }

  .btn-hero-ghost:hover {
    color: #fff;
    border-color: transparent;
    transform: translateY(-1px);
  }

  .btn-hero-ghost:hover::before {
    opacity: 1;
  }

  .btn-hero-ghost:active {
    transform: translateY(0);
  }

  .btn-hero-ghost:focus-visible {
    outline: 3px solid var(--color4);
    outline-offset: 3px;
  }

  /* Los hijos directos quedan sobre el ::before (z-index auto → nivel 6) */
  .btn-hero-ghost > span {
    position: relative;
    z-index: 1;
  }

  .btn-hero-ghost-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    transition:
      background var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .btn-hero-ghost:hover .btn-hero-ghost-arrow {
    background: rgba(255, 255, 255, 0.2);
    transform: translateX(3px);
  }

  /* Trust */
  .hero-trust {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
    padding-top: var(--space-4);
    border-top: 1px solid rgba(255,255,255,0.12);
  }

  .trust-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .trust-item strong {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    color: #fff;
  }

  .trust-item span {
    font-size: var(--text-xs);
    color: rgba(255,255,255,0.55);
    font-weight: 400;
    line-height: 1;
  }

  .trust-divider {
    width: 1px;
    height: 32px;
    background: rgba(255,255,255,0.2);
    flex-shrink: 0;
  }

  /* Photo column */
  .hero-photo {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    min-height: 380px;
  }

  @media (min-width: 900px) {
    .hero-photo {
      justify-content: flex-end;
      min-height: 560px;
    }
  }

  .hero-img {
    height: min(580px, 80vw);
    width: auto;
    object-fit: contain;
    object-position: bottom center;
    filter: drop-shadow(0 20px 60px rgba(59, 29, 225, 0.5));
    position: relative;
    z-index: 1;
    mask-image: linear-gradient(to bottom, black 55%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 55%, transparent 100%);
  }

  @media (min-width: 900px) {
    .hero-img {
      height: min(760px, 58vh);
      position: absolute;
      right: 0;
      bottom: 0;
    }
  }

  /* Floating card */
  .hero-card-float {
    position: absolute;
    bottom: 30px;
    left: 0;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(16px);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    box-shadow: var(--shadow-xl);
    max-width: 220px;
    z-index: 2;
    animation: float-card 4s ease-in-out infinite;
  }

  @media (max-width: 899px) {
    .hero-card-float {
      bottom: -12px;
      left: 50%;
      transform: translateX(-50%);
      animation: none;
    }
  }

  @keyframes float-card {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-8px); }
  }

  .float-icon {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, var(--color1), var(--color3));
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    flex-shrink: 0;
  }

  .float-title {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
    max-width: none;
    line-height: 1.3;
  }

  .float-sub {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
    max-width: none;
    line-height: 1.3;
  }

  /* Scroll indicator */
  .hero-scroll {
    position: absolute;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    animation: scroll-bounce 2s ease-in-out infinite;
  }

  @media (max-width: 899px) { .hero-scroll { display: none; } }

  .scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, transparent, rgba(255,255,255,0.5));
  }

  .scroll-label {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  @keyframes scroll-bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%       { transform: translateX(-50%) translateY(8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .shape-circle-lg, .shape-circle-sm, .shape-ring { animation: none; }
    .badge-dot { animation: none; }
    .hero-scroll { animation: none; }
    .hero-card-float { animation: none; }
  }
</style>
