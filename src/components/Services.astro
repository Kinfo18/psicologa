---
const services = [
  {
    num: '01',
    title: 'Ansiedad y estrés',
    desc: 'Técnicas basadas en evidencia para entender y regular los ciclos de ansiedad, el estrés crónico y los ataques de pánico.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96-.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3z"/><path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96-.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3z"/></svg>`,
  },
  {
    num: '02',
    title: 'Depresión y estados de ánimo',
    desc: 'Acompañamiento empático y estructurado para salir de la tristeza persistente y recuperar el disfrute de la vida cotidiana.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
  },
  {
    num: '03',
    title: 'Duelo y pérdidas',
    desc: 'Espacio seguro para transitar pérdidas afectivas, laborales o de vida con herramientas que honren tu proceso real.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>`,
  },
  {
    num: '04',
    title: 'Autoestima e identidad',
    desc: 'Trabajo profundo sobre la imagen propia, los límites personales y el desarrollo de una identidad sólida y auténtica.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
  },
  {
    num: '05',
    title: 'Relaciones afectivas',
    desc: 'Mejora la comunicación, comprende tus patrones vinculares y construye relaciones más sanas y conscientes.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
  {
    num: '06',
    title: 'Orientación vocacional',
    desc: 'Claridad sobre tu camino profesional y proyecto de vida, con herramientas que van más allá de un test de aptitudes.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>`,
  },
  {
    num: '07',
    title: 'Contextos rurales y migración',
    desc: 'Atención especializada para personas del Casanare profundo: San Luis de Palenque, Trinidad, Hato Corozal y más.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 3 4 8 5-5 5 15H2L8 3z"/></svg>`,
  },
];
---

<section id="servicios" class="section services" aria-labelledby="services-heading">
  <div class="container">

    <div class="services-header">
      <p class="section-label reveal">Áreas de atención</p>
      <h2 id="services-heading" class="section-heading reveal delay-100">
        ¿En qué puedo<br>
        <em>acompañarte?</em>
      </h2>
      <p class="section-sub reveal delay-200">
        Trabajo con adolescentes, jóvenes y adultos en procesos individuales,
        adaptando siempre el enfoque a tu historia y contexto de vida.
      </p>
    </div>

    <ul class="services-grid" role="list">
      {services.map((s, i) => (
        <li
          class={`service-card reveal delay-${Math.min((i + 1) * 100, 600)}`}
          style={i === 0 || i === 3 ? 'grid-column: span 1;' : ''}
        >
          <div class="service-num" aria-hidden="true">{s.num}</div>
          <div class="service-icon" aria-hidden="true" set:html={s.icon} />
          <h3 class="service-title">{s.title}</h3>
          <p class="service-desc">{s.desc}</p>
          <div class="service-arrow" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </div>
        </li>
      ))}
    </ul>

    <div class="services-cta reveal">
      <p>¿No encuentras lo que buscas? Cuéntame y encontramos el camino juntos.</p>
      <a
        href="https://wa.me/573000000000?text=Hola%20Sof%C3%ADa%2C%20tengo%20una%20consulta"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-ghost"
      >
        Hablar con Sofía
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--color-surface-2);
    position: relative;
    overflow: hidden;
  }

  .services::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(210, 149, 255, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .services-header {
    max-width: 640px;
    margin-bottom: var(--space-12);
  }

  /* Grid */
  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 640px) {
    .services-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .services-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* Card */
  .service-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    position: relative;
    overflow: hidden;
    cursor: default;
    transition: transform var(--dur-base) var(--ease-out),
                box-shadow var(--dur-base) var(--ease-out),
                border-color var(--dur-base) var(--ease-out);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .service-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--grad-card);
    opacity: 0;
    transition: opacity var(--dur-base);
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color4);
  }

  .service-card:hover::before { opacity: 1; }

  .service-card:hover .service-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .service-num {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--color4);
    position: relative;
    z-index: 1;
  }

  .service-icon {
    width: 52px;
    height: 52px;
    background: var(--color-surface-2);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color3);
    transition: background var(--dur-base), color var(--dur-base);
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .service-card:hover .service-icon {
    background: linear-gradient(135deg, var(--color1), var(--color3));
    color: #fff;
  }

  .service-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.3;
    position: relative;
    z-index: 1;
  }

  .service-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: none;
    position: relative;
    z-index: 1;
    flex: 1;
  }

  .service-arrow {
    color: var(--color2);
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity var(--dur-base), transform var(--dur-base) var(--ease-out);
    margin-top: auto;
    position: relative;
    z-index: 1;
  }

  /* Bottom CTA */
  .services-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
    padding: var(--space-8);
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .services-cta {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .services-cta p {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    max-width: 48ch;
    margin: 0;
  }
</style>
