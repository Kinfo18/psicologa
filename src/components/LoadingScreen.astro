---
---
<div id="loading-screen" role="status" aria-label="Cargando sitio web">
  <video
    id="loading-video"
    src="/assets/video/logo-animado.mp4"
    autoplay
    muted
    playsinline
    preload="auto"
    aria-hidden="true"
  ></video>
</div>

<script>
  const screen = document.getElementById('loading-screen') as HTMLElement;
  const video  = document.getElementById('loading-video')  as HTMLVideoElement;

  function dismiss() {
    if (!screen || screen.classList.contains('fade-out')) return;
    screen.classList.add('fade-out');
    setTimeout(() => {
      screen.remove();
      document.body.classList.remove('loading');
    }, 850);
  }

  if (video) {
    video.addEventListener('ended', dismiss);
    video.addEventListener('error', dismiss);
    // Fallback: máximo 8 s por si el video tarda
    setTimeout(dismiss, 8000);
  } else {
    dismiss();
  }
</script>

<style is:global>
  /* Reduced-motion: dismiss loader immediately, no animation needed */
  @media (prefers-reduced-motion: reduce) {
    #loading-screen { display: none !important; }
  }
</style>
